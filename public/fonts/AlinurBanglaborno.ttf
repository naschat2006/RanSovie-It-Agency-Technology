
<html>
<head>
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<meta charset="utf-8" />
	<title>404 - Not Found</title>
	<meta name="theme-color" content="#c60b0D" />
	<meta property="og:type" content="website" />
	<meta property="og:title" content="লিপিঘর" />
	<meta property="og:description" content="নতুন প্রজন্মের বাংলা ফন্ট ফাউন্ড্রি" />
	<link href="https://fonts.googleapis.com/css?family=Montserrat:400,500,700,900&display=swap" rel="stylesheet">
	<meta property="og:image" content="https://lipighor.com/newimg/main_banner.png" />
    <link rel="shortcut icon" href="img/favicon.ico" type="image/x-icon">
	<script src="/js/jquery-3.3.1.min.js"></script>
	<link rel="stylesheet" href="/css/webfont.css?xmamon" />
	<style>
		a {
			text-decoration: none;
			color: #FFFFFF;
		}
		body {
			margin: 0;
			background: linear-gradient(80deg, #cc0000, #ff0000);
			background-repeat: no-repeat;
   			background-attachment: fixed;
			font-family: ShorifSandwip;
			font-weight: 500;
			font-size: 15px;
			color: #FFFFFF;
			position: fixed;
			top: 50%;
			left: 50%;
			/* bring your own prefixes */
			transform: translate(-50%, -50%);
			text-align: center;
		}
		
		.t1 {
			font-size: 150px;
			background: linear-gradient(90deg, #FFFF00, #FFAA00);
			-webkit-background-clip: text;
			-webkit-text-fill-color: transparent;
			font-family: 'Montserrat', sans-serif;
			font-weight: 900;
		}
		
		.t2 {
			font-size: 50px;
		}
		hr {
			width: 200px;
			border: 1px solid rgb(0,0,0,0.2);
			margin: 20px auto;
		}
		
		.return {
			padding: 12px 24px; 
			border: #FFFFFF 2px solid; 
			border-radius: 30px; 
			width: 200px; 
			text-align: center; 
			margin: 15px 0;
			transition: 0.5s;
			display: inline-block;
			cursor: pointer;
			font-size: 30px;
		}
		
		.return:hover {
			background: #FFFFFF;
			color: #CC0000;
		}
		
		img {
			width: 240px;
			padding: 10px;
		}
		
		@media only screen and (max-width: 900px) {
			.t1 {
				font-size: 120px;
			}			

			.t2 {
				font-size: 40px;
				
			}	
			img {
				width: 220px;
			}
		}
	</style>
</head>
<body>
	<img src="/newimg/logo.svg"/>
	<hr/>
	<div class="t1">404</div>
	<div class="t2">কিছু পাওয়া যায়নি</div>
	<br/><br/>
	<a href="/"><div class="return">প্রথম পাতায় যান</div></a>
</body>
</html>