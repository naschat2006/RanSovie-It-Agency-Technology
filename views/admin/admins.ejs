<div class="space-y-6">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-black text-white">Admin Users Management</h1>
  </div>
  <div class="bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden">
    <table class="w-full text-left border-collapse">
      <thead>
        <tr class="border-b border-slate-800 text-xs text-gray-400 bg-slate-950">
          <th class="p-4">Name</th>
          <th class="p-4">Email</th>
          <th class="p-4">Role</th>
          <th class="p-4">Status</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-800 text-sm">
        <% admins.forEach(a => { %>
        <tr>
          <td class="p-4 font-semibold text-white"><%= a.name %></td>
          <td class="p-4 text-gray-300"><%= a.email %></td>
          <td class="p-4 text-yellow-400"><%= a.role %></td>
          <td class="p-4 text-gray-300"><%= a.status %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
