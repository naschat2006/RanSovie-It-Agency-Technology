<div class="space-y-6">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-black text-white">Manage Blog Posts</h1>
    <a href="/rsadminn/blog/add" class="bg-yellow-500 hover:bg-yellow-400 text-slate-950 px-4 py-2 rounded-xl text-sm font-bold transition">Add Post</a>
  </div>
  
  <div class="bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden">
    <table class="w-full text-sm text-left">
      <thead class="bg-slate-800 text-gray-400 uppercase text-xs">
        <tr>
          <th class="px-6 py-4">Title (EN)</th>
          <th class="px-6 py-4">Author</th>
          <th class="px-6 py-4">Status</th>
          <th class="px-6 py-4 text-right">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-800">
        <% posts.forEach(post => { %>
        <tr class="hover:bg-slate-800/50">
          <td class="px-6 py-4 font-semibold text-white"><%= post.title_en %></td>
          <td class="px-6 py-4 text-gray-300"><%= post.author %></td>
          <td class="px-6 py-4">
            <span class="px-2 py-1 rounded text-[10px] font-bold <%= post.status === 'published' ? 'bg-emerald-500/10 text-emerald-400' : 'bg-amber-500/10 text-amber-400' %>">
              <%= post.status %>
            </span>
          </td>
          <td class="px-6 py-4 text-right space-x-2">
            <a href="/rsadminn/blog/edit/<%= post.id %>" class="text-yellow-400 hover:text-yellow-300 transition"><i class="fa-solid fa-pen"></i></a>
            <form action="/rsadminn/blog/delete/<%= post.id %>" method="POST" class="inline-block" onsubmit="return confirm('Are you sure?')">
              <button type="submit" class="text-red-400 hover:text-red-300 transition"><i class="fa-solid fa-trash"></i></button>
            </form>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
