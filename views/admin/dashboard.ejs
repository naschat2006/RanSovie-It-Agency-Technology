<div class="space-y-8">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-black text-white">Dashboard Overview</h1>
    <span class="text-xs text-gray-400">Welcome back, <%= session.name || session.email %></span>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
    <div class="bg-slate-900 border border-slate-800 p-6 rounded-2xl space-y-2">
      <p class="text-xs text-gray-400 font-semibold uppercase">New Messages & Quotes</p>
      <div class="text-3xl font-black text-yellow-400"><%= stats.messagesCount %></div>
    </div>
    <div class="bg-slate-900 border border-slate-800 p-6 rounded-2xl space-y-2">
      <p class="text-xs text-gray-400 font-semibold uppercase">Newsletter Subscribers</p>
      <div class="text-3xl font-black text-yellow-400"><%= stats.subscribersCount %></div>
    </div>
    <div class="bg-slate-900 border border-slate-800 p-6 rounded-2xl space-y-2">
      <p class="text-xs text-gray-400 font-semibold uppercase">Published Blog Posts</p>
      <div class="text-3xl font-black text-yellow-400"><%= stats.postsCount %></div>
    </div>
    <div class="bg-slate-900 border border-slate-800 p-6 rounded-2xl space-y-2">
      <p class="text-xs text-gray-400 font-semibold uppercase">Active Services</p>
      <div class="text-3xl font-black text-yellow-400"><%= stats.servicesCount %></div>
    </div>
  </div>

  <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6 space-y-4">
    <h2 class="text-lg font-bold text-white">Quick Actions</h2>
    <div class="flex flex-wrap gap-4">
      <a href="/rsadminn/settings" class="bg-slate-800 hover:bg-slate-700 text-white px-4 py-2.5 rounded-xl text-xs font-semibold border border-slate-700 transition">Update Global Settings</a>
      <a href="/rsadminn/services" class="bg-slate-800 hover:bg-slate-700 text-white px-4 py-2.5 rounded-xl text-xs font-semibold border border-slate-700 transition">Manage Services</a>
      <a href="/rsadminn/blog" class="bg-slate-800 hover:bg-slate-700 text-white px-4 py-2.5 rounded-xl text-xs font-semibold border border-slate-700 transition">Write New Blog Post</a>
      <a href="/rsadminn/backup" class="bg-yellow-500 hover:bg-yellow-400 text-slate-950 px-4 py-2.5 rounded-xl text-xs font-bold transition">Source & Backup ZIP</a>
    </div>
  </div>
</div>
