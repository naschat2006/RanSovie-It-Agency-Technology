<div class="space-y-6">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-black text-white">Inbox & Quote Requests</h1>
    <a href="/rsadminn/inbox/export" class="bg-yellow-500 hover:bg-yellow-400 text-slate-950 font-bold px-4 py-2 rounded-xl text-xs transition">Export CSV</a>
  </div>
  <div class="bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden">
    <table class="w-full text-left border-collapse">
      <thead>
        <tr class="border-b border-slate-800 text-xs text-gray-400 bg-slate-950">
          <th class="p-4">Name</th>
          <th class="p-4">Email</th>
          <th class="p-4">Phone</th>
          <th class="p-4">Service</th>
          <th class="p-4">Message</th>
          <th class="p-4">Date</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-800 text-sm">
        <% messages.forEach(m => { %>
        <tr>
          <td class="p-4 font-semibold text-white"><%= m.name %></td>
          <td class="p-4 text-gray-300"><%= m.email %></td>
          <td class="p-4 text-gray-400"><%= m.phone %></td>
          <td class="p-4 text-yellow-400"><%= m.service %></td>
          <td class="p-4 text-gray-300"><%= m.message %></td>
          <td class="p-4 text-gray-500 text-xs"><%= m.created_at %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
