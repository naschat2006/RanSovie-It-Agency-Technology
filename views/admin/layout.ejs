<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-950">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Admin Panel' %> - RanSovie IT</title>
  <meta name="robots" content="noindex, nofollow">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brand: { navy: '#0B132B', dark: '#1C2541', gold: '#F4D35E' }
          }
        }
      }
    }
  </script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <!-- Immediate Theme Initializer -->
  <script>
    document.documentElement.classList.remove('dark');
    localStorage.theme = 'light';
  </script>
</head>
<body class="bg-[#FAF9F6] text-gray-900 transition-colors duration-300 antialiased overflow-x-hidden">
  <div class="min-h-full flex">
    <!-- Sidebar -->
    <aside class="w-64 bg-slate-900 border-r border-slate-800 flex flex-col justify-between hidden md:flex">
      <div>
        <div class="p-6 border-b border-slate-800 flex items-center gap-3">
          <img src="/01.png" alt="Logo" class="h-8 w-8 rounded bg-slate-800 p-1 object-contain">
          <div>
            <span class="font-bold text-white text-sm block">RanSovie Admin</span>
            <span class="text-[10px] text-yellow-400 block"><%= session.role === 'super_admin' ? 'Super Admin' : 'Admin' %></span>
          </div>
        </div>
        <nav class="p-4 space-y-1 text-sm font-medium">
          <a href="/rsadminn" class="flex items-center gap-3 px-4 py-2.5 rounded-xl hover:bg-slate-800 text-gray-300 hover:text-white transition"><i class="fa-solid fa-chart-pie text-yellow-500 w-5"></i> Dashboard</a>
          <a href="/rsadminn/settings" class="flex items-center gap-3 px-4 py-2.5 rounded-xl hover:bg-slate-800 text-gray-300 hover:text-white transition"><i class="fa-solid fa-gear text-yellow-500 w-5"></i> Global Settings</a>
          <a href="/rsadminn/services" class="flex items-center gap-3 px-4 py-2.5 rounded-xl hover:bg-slate-800 text-gray-300 hover:text-white transition"><i class="fa-solid fa-code text-yellow-500 w-5"></i> Services</a>
          <a href="/rsadminn/portfolio" class="flex items-center gap-3 px-4 py-2.5 rounded-xl hover:bg-slate-800 text-gray-300 hover:text-white transition"><i class="fa-solid fa-briefcase text-yellow-500 w-5"></i> Portfolio</a>
          <a href="/rsadminn/testimonials" class="flex items-center gap-3 px-4 py-2.5 rounded-xl hover:bg-slate-800 text-gray-300 hover:text-white transition"><i class="fa-solid fa-star text-yellow-500 w-5"></i> Testimonials</a>
          <a href="/rsadminn/team" class="flex items-center gap-3 px-4 py-2.5 rounded-xl hover:bg-slate-800 text-gray-300 hover:text-white transition"><i class="fa-solid fa-users text-yellow-500 w-5"></i> Team Members</a>
          <a href="/rsadminn/pricing" class="flex items-center gap-3 px-4 py-2.5 rounded-xl hover:bg-slate-800 text-gray-300 hover:text-white transition"><i class="fa-solid fa-tags text-yellow-500 w-5"></i> Pricing Plans</a>
          <a href="/rsadminn/faq" class="flex items-center gap-3 px-4 py-2.5 rounded-xl hover:bg-slate-800 text-gray-300 hover:text-white transition"><i class="fa-solid fa-circle-question text-yellow-500 w-5"></i> FAQ Items</a>
          <a href="/rsadminn/blog" class="flex items-center gap-3 px-4 py-2.5 rounded-xl hover:bg-slate-800 text-gray-300 hover:text-white transition"><i class="fa-solid fa-newspaper text-yellow-500 w-5"></i> Blog Posts</a>
          <a href="/rsadminn/inbox" class="flex items-center gap-3 px-4 py-2.5 rounded-xl hover:bg-slate-800 text-gray-300 hover:text-white transition"><i class="fa-solid fa-inbox text-yellow-500 w-5"></i> Inbox & Quotes</a>
          <a href="/rsadminn/subscribers" class="flex items-center gap-3 px-4 py-2.5 rounded-xl hover:bg-slate-800 text-gray-300 hover:text-white transition"><i class="fa-solid fa-envelope-open-text text-yellow-500 w-5"></i> Subscribers</a>
          <a href="/rsadminn/media" class="flex items-center gap-3 px-4 py-2.5 rounded-xl hover:bg-slate-800 text-gray-300 hover:text-white transition"><i class="fa-solid fa-images text-yellow-500 w-5"></i> Media Library</a>
          <% if (session.role === 'super_admin') { %>
          <a href="/rsadminn/admins" class="flex items-center gap-3 px-4 py-2.5 rounded-xl hover:bg-slate-800 text-gray-300 hover:text-white transition"><i class="fa-solid fa-user-shield text-yellow-500 w-5"></i> Admins</a>
          <% } %>
          <a href="/rsadminn/backup" class="flex items-center gap-3 px-4 py-2.5 rounded-xl hover:bg-slate-800 text-gray-300 hover:text-white transition"><i class="fa-solid fa-database text-yellow-500 w-5"></i> Source & Backup</a>
        </nav>
      </div>

      <div class="p-4 border-t border-slate-800 space-y-2">
        <a href="/rsadminn/password" class="flex items-center gap-2 text-xs text-gray-300 hover:text-white px-3 py-2 rounded-lg hover:bg-slate-800 transition"><i class="fa-solid fa-key text-yellow-500"></i> Change Password</a>
        <a href="/rsadminn/logout" class="flex items-center gap-2 text-xs text-red-400 hover:text-red-300 px-3 py-2 rounded-lg hover:bg-slate-800 transition"><i class="fa-solid fa-right-from-bracket"></i> Logout</a>
      </div>
    </aside>

    <!-- Content Area -->
    <div class="flex-1 flex flex-col min-w-0">
      <header class="bg-slate-900 border-b border-slate-800 h-16 flex items-center justify-between px-6">
        <div class="flex items-center gap-4">
          <span class="text-sm font-bold text-white"><%= typeof title !== 'undefined' ? title : 'Admin Panel' %></span>
        </div>
        <div class="flex items-center gap-4">
          <a href="/" target="_blank" class="text-xs bg-slate-800 hover:bg-slate-700 text-gray-300 px-3 py-1.5 rounded-lg border border-slate-700 transition flex items-center gap-1.5">
            <i class="fa-solid fa-globe text-yellow-500"></i> View Website
          </a>
          <span class="text-xs text-gray-400"><%= session.email %></span>
        </div>
      </header>

      <main class="flex-1 p-6 lg:p-10 overflow-y-auto">
        <%- body %>
      </main>
    </div>
  </div>
</body>
</html>
