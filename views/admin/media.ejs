<div class="space-y-6">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-black text-white">Media Library</h1>
    <form action="/rsadminn/media/upload" method="POST" enctype="multipart/form-data" class="flex items-center gap-2">
      <input type="file" name="image" required class="text-xs text-gray-400 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-bold file:bg-yellow-500 file:text-slate-950 hover:file:bg-yellow-400">
      <button type="submit" class="bg-yellow-500 hover:bg-yellow-400 text-slate-950 font-bold px-4 py-2 rounded-xl text-xs transition">Upload</button>
    </form>
  </div>
  <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
    <% media.forEach(m => { %>
    <div class="bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden p-4 space-y-3">
      <div class="h-32 bg-slate-950 rounded-xl overflow-hidden flex items-center justify-center">
        <img src="/uploads/<%= m.filename %>" alt="<%= m.original_name %>" class="h-full w-full object-cover">
      </div>
      <p class="text-xs text-gray-300 truncate"><%= m.original_name %></p>
    </div>
    <% }) %>
  </div>
</div>
