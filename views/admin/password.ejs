<div class="space-y-6">
  <h1 class="text-2xl font-black text-white">Change Admin Password</h1>

  <% if (success) { %>
  <div class="bg-emerald-500/10 border border-emerald-500/50 text-emerald-400 p-3 rounded-xl text-xs font-semibold">
    Password changed successfully!
  </div>
  <% } %>
  <% if (error) { %>
  <div class="bg-red-500/10 border border-red-500/50 text-red-400 p-3 rounded-xl text-xs font-semibold">
    <%= error %>
  </div>
  <% } %>

  <form action="/rsadminn/password" method="POST" class="max-w-md bg-slate-900 border border-slate-800 p-8 rounded-2xl space-y-4">
    <div>
      <label class="block text-xs font-semibold text-gray-300 mb-2">Current Password</label>
      <input type="password" name="current_password" required class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-white text-sm focus:outline-none focus:border-yellow-500">
    </div>
    <div>
      <label class="block text-xs font-semibold text-gray-300 mb-2">New Password</label>
      <input type="password" name="new_password" required class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-white text-sm focus:outline-none focus:border-yellow-500">
    </div>
    <button type="submit" class="w-full bg-yellow-500 hover:bg-yellow-400 text-slate-950 font-bold py-3 rounded-xl transition text-sm shadow-lg">
      Update Password
    </button>
  </form>
</div>
