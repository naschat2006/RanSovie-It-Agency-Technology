<div class="space-y-6">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-black text-white"><%= project ? 'Edit' : 'Add' %> Portfolio Project</h1>
    <a href="/rsadminn/portfolio" class="bg-slate-800 hover:bg-slate-700 text-white px-4 py-2 rounded-xl text-sm font-semibold transition">Back to List</a>
  </div>
  
  <form action="<%= project ? '/rsadminn/portfolio/edit/' + project.id : '/rsadminn/portfolio/add' %>" method="POST" class="bg-slate-900 border border-slate-800 p-8 rounded-2xl space-y-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <label class="block text-xs font-semibold text-gray-300 mb-2">Title (EN)</label>
        <input type="text" name="title_en" value="<%= project ? project.title_en : '' %>" required class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-white text-sm focus:border-yellow-500 outline-none">
      </div>
      <div>
        <label class="block text-xs font-semibold text-gray-300 mb-2">Title (BN)</label>
        <input type="text" name="title_bn" value="<%= project ? project.title_bn : '' %>" required class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-white text-sm focus:border-yellow-500 outline-none">
      </div>
      <div>
        <label class="block text-xs font-semibold text-gray-300 mb-2">Client</label>
        <input type="text" name="client" value="<%= project ? project.client : '' %>" required class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-white text-sm focus:border-yellow-500 outline-none">
      </div>
      <div>
        <label class="block text-xs font-semibold text-gray-300 mb-2">Category</label>
        <input type="text" name="category" value="<%= project ? project.category : '' %>" required class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-white text-sm focus:border-yellow-500 outline-none">
      </div>
      <div class="md:col-span-2">
        <label class="block text-xs font-semibold text-gray-300 mb-2">Description (EN)</label>
        <textarea name="description_en" rows="3" required class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-white text-sm focus:border-yellow-500 outline-none"><%= project ? project.description_en : '' %></textarea>
      </div>
      <div class="md:col-span-2">
        <label class="block text-xs font-semibold text-gray-300 mb-2">Description (BN)</label>
        <textarea name="description_bn" rows="3" required class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-white text-sm focus:border-yellow-500 outline-none"><%= project ? project.description_bn : '' %></textarea>
      </div>
      <div>
        <label class="block text-xs font-semibold text-gray-300 mb-2">Image URL</label>
        <input type="text" name="image" value="<%= project ? project.image : '' %>" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-white text-sm focus:border-yellow-500 outline-none">
      </div>
      <div>
        <label class="block text-xs font-semibold text-gray-300 mb-2">Live Link</label>
        <input type="url" name="link" value="<%= project ? project.link : '' %>" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-white text-sm focus:border-yellow-500 outline-none">
      </div>
      <div>
        <label class="block text-xs font-semibold text-gray-300 mb-2">Sort Order</label>
        <input type="number" name="sort_order" value="<%= project ? project.sort_order : 0 %>" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-white text-sm focus:border-yellow-500 outline-none">
      </div>
      <div class="flex items-center gap-2">
        <input type="checkbox" name="is_active" value="1" <%= !project || project.is_active ? 'checked' : '' %> class="w-5 h-5 accent-yellow-500">
        <label class="text-sm text-gray-300">Is Active</label>
      </div>
    </div>
    
    <button type="submit" class="w-full bg-yellow-500 hover:bg-yellow-400 text-slate-950 font-bold py-3 rounded-xl transition shadow-lg">
      <%= project ? 'Update Project' : 'Add Project' %>
    </button>
  </form>
</div>
