<div class="space-y-6">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-black text-white">Manage Services</h1>
  </div>

  <div class="bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden">
    <table class="w-full text-left border-collapse">
      <thead>
        <tr class="border-b border-slate-800 text-xs text-gray-400 bg-slate-950">
          <th class="p-4">Title (EN)</th>
          <th class="p-4">Title (BN)</th>
          <th class="p-4">Slug</th>
          <th class="p-4">Action</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-800 text-sm">
        <% services.forEach(s => { %>
        <tr>
          <td class="p-4 font-semibold text-white"><%= s.title_en %></td>
          <td class="p-4 text-gray-300"><%= s.title_bn %></td>
          <td class="p-4 text-gray-400"><%= s.slug %></td>
          <td class="p-4">
            <a href="/rsadminn/services/edit/<%= s.id %>" class="text-yellow-400 hover:underline text-xs font-semibold">Edit</a>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
