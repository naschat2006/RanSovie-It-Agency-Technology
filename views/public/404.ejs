<section class="py-32 bg-slate-950 text-center">
  <div class="max-w-xl mx-auto px-4 space-y-6">
    <div class="text-6xl font-black text-yellow-500">404</div>
    <h1 class="text-3xl font-bold text-white"><%= lang === 'bn' ? 'পৃষ্ঠাটি পাওয়া যায়নি' : 'Page Not Found' %></h1>
    <p class="text-gray-400 text-sm"><%= lang === 'bn' ? 'আপনি যে পৃষ্ঠাটি খুঁজছেন তা হয়তো সরানো হয়েছে অথবা বিদ্যমান নেই।' : 'The page you are looking for might have been removed, had its name changed, or is temporarily unavailable.' %></p>
    <div>
      <a href="/" class="inline-block bg-yellow-500 hover:bg-yellow-400 text-slate-950 font-bold px-8 py-3 rounded-xl transition">
        <%= lang === 'bn' ? 'হোম পেজে ফিরে যান' : 'Back to Homepage' %>
      </a>
    </div>
  </div>
</section>
