<section class="py-20 bg-slate-950">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
      <h1 class="text-4xl font-black text-white"><%= lang === 'bn' ? 'টেক ব্লগ ও আর্টিকেল' : 'Tech Blog & Insights' %></h1>
      <p class="text-gray-400 text-base"><%= lang === 'bn' ? 'সফটওয়্যার ইঞ্জিনিয়ারিং, এআই এবং টেকনোলজি নিয়ে আমাদের সর্বশেষ আর্টিকেল।' : 'Explore our latest articles on software engineering, cloud, and digital growth.' %></p>
    </div>

    <% if (posts && posts.length > 0) { %>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <% posts.forEach(post => { %>
      <div class="bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden group hover:border-yellow-500/50 transition flex flex-col justify-between">
        <div>
          <% if (post.cover_image) { %>
          <div class="h-48 overflow-hidden">
            <img src="<%= post.cover_image %>" alt="<%= post.title_en %>" class="w-full h-full object-cover group-hover:scale-105 transition duration-500">
          </div>
          <% } %>
          <div class="p-6 space-y-3">
            <div class="flex items-center gap-4 text-xs text-gray-400">
              <span><i class="fa-solid fa-calendar text-yellow-500"></i> <%= post.date %></span>
              <span><i class="fa-solid fa-user text-yellow-500"></i> <%= post.author %></span>
            </div>
            <h2 class="text-xl font-bold text-white"><%= lang === 'bn' ? post.title_bn : post.title_en %></h2>
          </div>
        </div>
        <div class="px-6 pb-6">
          <a href="/blog/<%= post.slug %>" class="text-yellow-400 font-semibold text-xs inline-flex items-center gap-2">
            <%= lang === 'bn' ? 'সম্পূর্ণ পড়ুন' : 'Read Article' %> <i class="fa-solid fa-arrow-right"></i>
          </a>
        </div>
      </div>
      <% }) %>
    </div>
    <% } else { %>
    <div class="text-center py-16 bg-slate-900 border border-slate-800 rounded-2xl max-w-xl mx-auto space-y-4">
      <div class="text-4xl text-yellow-500"><i class="fa-solid fa-newspaper"></i></div>
      <h2 class="text-xl font-bold text-white"><%= lang === 'bn' ? 'শীঘ্রই নতুন ব্লগ আসছে' : 'Articles Coming Soon' %></h2>
      <p class="text-gray-400 text-sm"><%= lang === 'bn' ? 'আমাদের টেক ব্লগ আর্টিকেল খুব শীঘ্রই প্রকাশিত হবে।' : 'Our technical blog posts will be published here shortly.' %></p>
    </div>
    <% } %>
  </div>
</section>
