<section class="py-20 bg-slate-950">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
      <h1 class="text-4xl font-black text-white"><%= lang === 'bn' ? 'যোগাযোগ করুন' : 'Get In Touch' %></h1>
      <p class="text-gray-400 text-base"><%= lang === 'bn' ? 'আপনার প্রজেক্ট আইডিয়া নিয়ে আমাদের সাথে কথা বলুন।' : 'Let us discuss your project requirements and collaborate for success.' %></p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
      <div class="lg:col-span-5 space-y-8 bg-slate-900 border border-slate-800 p-8 rounded-2xl">
        <h2 class="text-2xl font-bold text-white"><%= lang === 'bn' ? 'আমাদের অফিস ঠিকানা' : 'Office Information' %></h2>
        <div class="space-y-4 text-gray-300 text-sm">
          <p class="flex items-start gap-3"><i class="fa-solid fa-location-dot text-yellow-500 mt-1"></i> <span><%= settings.address %></span></p>
          <p class="flex items-center gap-3"><i class="fa-solid fa-phone text-yellow-500"></i> <span><%= settings.phone %></span></p>
          <p class="flex items-center gap-3"><i class="fa-solid fa-envelope text-yellow-500"></i> <span><%= settings.email %></span></p>
          <p class="flex items-center gap-3"><i class="fa-solid fa-clock text-yellow-500"></i> <span><%= lang === 'bn' ? settings.working_hours_bn || settings.working_hours : settings.working_hours %></span></p>
        </div>
      </div>

      <div class="lg:col-span-7 bg-slate-900 border border-slate-800 p-8 rounded-2xl">
        <% if (success) { %>
        <div class="bg-emerald-500/10 border border-emerald-500/50 text-emerald-400 p-4 rounded-xl mb-6 text-sm font-semibold">
          <%= lang === 'bn' ? 'আপনার বার্তা সফলভাবে পাঠানো হয়েছে! শীঘ্রই আমরা যোগাযোগ করব।' : 'Your message has been successfully submitted! We will get back to you shortly.' %>
        </div>
        <% } %>

        <form action="/contact" method="POST" class="space-y-6">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>
              <label class="block text-xs font-semibold text-gray-300 mb-2"><%= lang === 'bn' ? 'আপনার নাম' : 'Your Name' %></label>
              <input type="text" name="name" required class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-yellow-500">
            </div>
            <div>
              <label class="block text-xs font-semibold text-gray-300 mb-2"><%= lang === 'bn' ? 'ইমেইল ঠিকানা' : 'Email Address' %></label>
              <input type="email" name="email" required class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-yellow-500">
            </div>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>
              <label class="block text-xs font-semibold text-gray-300 mb-2"><%= lang === 'bn' ? 'ফোন নম্বর' : 'Phone Number' %></label>
              <input type="text" name="phone" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-yellow-500">
            </div>
            <div>
              <label class="block text-xs font-semibold text-gray-300 mb-2"><%= lang === 'bn' ? 'সেবা নির্বাচন করুন' : 'Select Service' %></label>
              <select name="service" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-yellow-500">
                <option value="Web Development"><%= lang === 'bn' ? 'ওয়েব ডেভেলপমেন্ট' : 'Web Development' %></option>
                <option value="Mobile App"><%= lang === 'bn' ? 'মোবাইল অ্যাপ' : 'Mobile App' %></option>
                <option value="UI/UX Design"><%= lang === 'bn' ? 'ইউআই/ইউএক্স ডিজাইন' : 'UI/UX Design' %></option>
                <option value="Digital Marketing"><%= lang === 'bn' ? 'ডিজিটাল মার্কেটিং' : 'Digital Marketing' %></option>
              </select>
            </div>
          </div>
          <div>
            <label class="block text-xs font-semibold text-gray-300 mb-2"><%= lang === 'bn' ? 'বার্তা বা প্রজেক্ট বিবরণ' : 'Project Details / Message' %></label>
            <textarea name="message" rows="4" required class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-yellow-500" placeholder="<%= lang === 'bn' ? 'আপনার রিকোয়ারমেন্ট লিখুন...' : 'Describe your project requirements...' %>"><%= typeof prefillPlan !== 'undefined' && prefillPlan ? 'Interested in plan: ' + prefillPlan : '' %></textarea>
          </div>
          <button type="submit" class="w-full bg-yellow-500 hover:bg-yellow-400 text-slate-950 font-bold py-3.5 rounded-xl transition shadow-lg">
            <%= lang === 'bn' ? 'বার্তা পাঠান' : 'Send Message' %>
          </button>
        </form>
      </div>
    </div>
  </div>
</section>
