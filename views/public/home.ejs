<!-- Hero Section -->
<section class="relative bg-gradient-to-b from-slate-950 via-slate-900 to-slate-950 py-24 lg:py-32 overflow-hidden">
  <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#F4D35E_1px,transparent_1px)] [background-size:16px_16px]"></div>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <div class="lg:col-span-7 space-y-8 text-center lg:text-left">
        <div class="inline-flex items-center gap-2 bg-slate-800 border border-slate-700 px-4 py-1.5 rounded-full text-xs font-semibold text-yellow-400">
          <i class="fa-solid fa-sparkles"></i> <%= lang === 'bn' ? 'নেক্সট-জেন সফটওয়্যার ও এআই এজেন্সি' : 'Next-Gen Software & AI Agency' %>
        </div>
        <h1 class="text-4xl sm:text-6xl font-black text-white tracking-tight leading-tight">
          <%= lang === 'bn' ? 'আপনার ডিজিটাল রূপান্তর ও ব্যবসায়িক বৃদ্ধিতে বিশ্বস্ত অংশীদার' : 'Transforming Ideas Into Scalable Digital Excellence' %>
        </h1>
        <p class="text-lg text-gray-300 max-w-2xl mx-auto lg:mx-0">
          <%= lang === 'bn' ? 'র‍্যানসোভি আইটি এজেন্সি এন্ড টেকনোলজি বিশ্বমানের কাস্টম সফটওয়্যার, ওয়েব অ্যাপ্লিকেশন, মোবাইল অ্যাপ এবং গ্রোথ মার্কেটিং সেবা প্রদান করে।' : 'RanSovie IT Agency & Technology delivers enterprise-grade software, high-performance web apps, mobile apps, and growth marketing.' %>
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4">
          <a href="/contact" class="w-full sm:w-auto bg-yellow-500 hover:bg-yellow-400 text-slate-950 px-8 py-4 rounded-xl font-bold shadow-lg transition flex items-center justify-center gap-2 text-base">
            <i class="fa-solid fa-rocket"></i> <%= lang === 'bn' ? 'প্রোজেক্ট শুরু করুন' : 'Start Your Project' %>
          </a>
          <a href="/portfolio" class="w-full sm:w-auto bg-slate-800 hover:bg-slate-700 text-white px-8 py-4 rounded-xl font-bold border border-slate-700 transition flex items-center justify-center gap-2 text-base">
            <i class="fa-solid fa-briefcase"></i> <%= lang === 'bn' ? 'আমাদের কাজ দেখুন' : 'View Portfolio' %>
          </a>
        </div>
      </div>
      <div class="lg:col-span-5">
        <div class="relative bg-gradient-to-tr from-yellow-500/20 to-slate-800 p-2 rounded-3xl border border-slate-700 shadow-2xl">
          <img src="https://images.unsplash.com/photo-1551434678-e076c223a692?w=800" alt="RanSovie Team" class="rounded-2xl object-cover w-full h-[380px]">
          <div class="absolute -bottom-6 -left-6 bg-slate-900 border border-slate-700 p-4 rounded-2xl shadow-xl flex items-center gap-4">
            <div class="bg-yellow-500 text-slate-950 p-3 rounded-xl font-bold text-xl">
              <i class="fa-solid fa-award"></i>
            </div>
            <div>
              <p class="text-xs text-gray-400"><%= lang === 'bn' ? 'অভিজ্ঞ টিম' : 'Expert Team' %></p>
              <p class="text-sm font-bold text-white"><%= lang === 'bn' ? 'প্রিমিয়াম কোয়ালিটি নিশ্চিত' : 'Enterprise Quality' %></p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Core Services Section -->
<section class="py-20 bg-slate-900 border-t border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white">
        <%= lang === 'bn' ? 'আমাদের কোর সেবাসমূহ' : 'Our Core Services' %>
      </h2>
      <p class="text-gray-400 text-base">
        <%= lang === 'bn' ? 'আপনার ব্যবসাকে ডিজিটাল যুগে এগিয়ে নিতে আমরা দিচ্ছি সর্বাধুনিক প্রযুক্তি সেবা।' : 'Empowering your business with cutting-edge digital solutions tailored to your growth.' %>
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      <% services.forEach(service => { %>
      <div class="bg-slate-950 border border-slate-800 hover:border-yellow-500/50 p-8 rounded-2xl transition duration-300 group flex flex-col justify-between">
        <div>
          <div class="w-14 h-14 rounded-xl bg-yellow-500/10 text-yellow-400 flex items-center justify-center text-2xl mb-6 group-hover:bg-yellow-500 group-hover:text-slate-950 transition">
            <i class="fa-solid fa-<%= service.icon.toLowerCase() === 'code' ? 'code' : (service.icon.toLowerCase() === 'palette' ? 'palette' : (service.icon.toLowerCase() === 'trendingup' ? 'chart-line' : 'mobile-screen')) %>"></i>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">
            <%= lang === 'bn' ? service.title_bn : service.title_en %>
          </h3>
          <p class="text-gray-400 text-sm leading-relaxed mb-6">
            <%= lang === 'bn' ? service.description_bn : service.description_en %>
          </p>
        </div>
        <a href="/services/<%= service.slug %>" class="inline-flex items-center gap-2 text-yellow-400 font-semibold text-sm group-hover:translate-x-1 transition">
          <%= lang === 'bn' ? 'বিস্তারিত জানুন' : 'Learn More' %> <i class="fa-solid fa-arrow-right"></i>
        </a>
      </div>
      <% }) %>
    </div>
  </div>
</section>

<!-- Featured Portfolio Section -->
<% if (portfolio && portfolio.length > 0) { %>
<section class="py-20 bg-slate-950 border-t border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row justify-between items-end mb-16 gap-6">
      <div class="space-y-3">
        <h2 class="text-3xl sm:text-4xl font-extrabold text-white">
          <%= lang === 'bn' ? 'আমাদের সাম্প্রতিক প্রজেক্টসমূহ' : 'Featured Portfolio' %>
        </h2>
        <p class="text-gray-400 text-base">
          <%= lang === 'bn' ? 'বিশ্বমানের ক্লায়েন্টদের জন্য সফলভাবে সম্পন্ন করা কিছু প্রজেক্ট।' : 'Explore our successfully delivered high-impact digital solutions.' %>
        </p>
      </div>
      <a href="/portfolio" class="bg-slate-800 hover:bg-slate-700 text-white px-6 py-3 rounded-xl font-semibold text-sm transition border border-slate-700">
        <%= lang === 'bn' ? 'সব প্রজেক্ট দেখুন' : 'View All Projects' %>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      <% portfolio.forEach(item => { %>
      <div class="bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden group hover:border-yellow-500/50 transition">
        <div class="relative overflow-hidden h-60">
          <img src="<%= item.image %>" alt="<%= item.title_en %>" class="w-full h-full object-cover group-hover:scale-105 transition duration-500">
          <span class="absolute top-4 left-4 bg-yellow-500 text-slate-950 px-3 py-1 rounded-lg text-xs font-bold">
            <%= item.category %>
          </span>
        </div>
        <div class="p-6 space-y-3">
          <p class="text-xs text-gray-400"><%= item.client %></p>
          <h3 class="text-xl font-bold text-white"><%= lang === 'bn' ? item.title_bn : item.title_en %></h3>
          <p class="text-gray-400 text-sm line-clamp-2"><%= lang === 'bn' ? item.description_bn : item.description_en %></p>
        </div>
      </div>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<!-- CTA Section -->
<section class="py-20 bg-gradient-to-r from-slate-900 via-slate-950 to-slate-900 border-t border-slate-800 relative overflow-hidden text-center">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6 relative z-10">
    <h2 class="text-3xl sm:text-5xl font-black text-white tracking-tight">
      <%= lang === 'bn' ? 'আপনার পরবর্তী প্রজেক্ট নিয়ে আলোচনা করতে চান?' : 'Ready to Build Your Next Big Idea?' %>
    </h2>
    <p class="text-gray-300 text-base sm:text-lg max-w-2xl mx-auto">
      <%= lang === 'bn' ? 'আজই আমাদের অভিজ্ঞ টেক টিমের সাথে যোগাযোগ করুন। আমরা দিচ্ছি ফ্রি কনসালটেশন।' : 'Contact our expert engineering team today for a free consultation and project estimate.' %>
    </p>
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-4">
      <a href="/contact" class="bg-yellow-500 hover:bg-yellow-400 text-slate-950 px-8 py-4 rounded-xl font-bold text-base shadow-xl transition">
        <%= lang === 'bn' ? 'ফ্রি কনসালটেশন নিন' : 'Get Free Consultation' %>
      </a>
      <a href="tel:<%= settings.phone %>" class="bg-slate-800 hover:bg-slate-700 text-white px-8 py-4 rounded-xl font-bold text-base border border-slate-700 transition">
        <i class="fa-solid fa-phone text-yellow-500 mr-2"></i> <%= settings.phone %>
      </a>
    </div>
  </div>
</section>
