<section class="py-20 bg-slate-950">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
      <h1 class="text-4xl font-black text-white"><%= lang === 'bn' ? 'স্বচ্ছ ও সাশ্রয়ী মূল্যতালিকা' : 'Transparent Pricing Plans' %></h1>
      <p class="text-gray-400 text-base"><%= lang === 'bn' ? 'আপনার প্রজেক্টের রিকোয়ারমেন্ট অনুযায়ী পারফেক্ট প্ল্যান বেছে নিন।' : 'Choose the ideal plan that matches your business scale and software requirements.' %></p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <% if (pricing && pricing.length > 0) { %>
        <% pricing.forEach(plan => { %>
        <div class="bg-slate-900 border <%= plan.is_popular ? 'border-yellow-500 shadow-xl' : 'border-slate-800' %> p-8 rounded-2xl flex flex-col justify-between relative">
          <% if (plan.is_popular) { %>
          <span class="absolute -top-3 left-1/2 -translate-x-1/2 bg-yellow-500 text-slate-950 px-4 py-1 rounded-full text-xs font-bold uppercase tracking-wider">
            <%= lang === 'bn' ? 'সবচেয়ে জনপ্রিয়' : 'Most Popular' %>
          </span>
          <% } %>
          <div class="space-y-6">
            <h2 class="text-2xl font-bold text-white"><%= lang === 'bn' ? plan.title_bn : plan.title_en %></h2>
            <div class="text-3xl font-black text-yellow-400">
              <%= lang === 'bn' ? '৳' + plan.price_bdt : '$' + plan.price_usd %>
              <span class="text-xs text-gray-400 font-normal">/ <%= plan.billing_cycle %></span>
            </div>
            <ul class="space-y-3 text-sm text-gray-300">
              <% const features = (lang === 'bn' ? plan.features_bn : plan.features_en).split('\n'); %>
              <% features.forEach(feat => { %>
                <% if (feat.trim()) { %>
                <li class="flex items-center gap-2"><i class="fa-solid fa-check text-yellow-500"></i> <%= feat.trim() %></li>
                <% } %>
              <% }) %>
            </ul>
          </div>
          <div class="pt-8">
            <a href="/contact?plan=<%= encodeURIComponent(plan.title_en) %>" class="block text-center bg-yellow-500 hover:bg-yellow-400 text-slate-950 py-3 rounded-xl font-bold text-sm transition">
              <%= lang === 'bn' ? 'এই প্ল্যানটি বেছে নিন' : 'Choose Plan' %>
            </a>
          </div>
        </div>
        <% }) %>
      <% } else { %>
        <div class="col-span-3 text-center py-16 bg-slate-900 border border-slate-800 rounded-2xl">
          <p class="text-gray-400"><%= lang === 'bn' ? 'কোনো প্রাইসিং প্ল্যান পাওয়া যায়নি।' : 'No pricing plans currently available.' %></p>
        </div>
      <% } %>
    </div>
  </div>
</section>
